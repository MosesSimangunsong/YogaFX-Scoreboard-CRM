flowchart TB
    classDef title fill:#111827,stroke:#c44b36,stroke-width:2px,color:#fff;
    classDef yes fill:#ecfdf5,stroke:#059669,stroke-width:1px,color:#064e3b;
    classDef no fill:#fef2f2,stroke:#dc2626,stroke-width:1px,color:#7f1d1d;

    title["YogaFX Scoreboard Capability Matrix"]

    subgraph Supported["System Should Support"]
        s1([Lead Qualification])
        s2([Assessment / Quiz Flow])
        s3([Scoring Engine])
        s4([Audience Segmentation via Result])
        s5([Result Presentation])
        s6([Email Follow-Up])
        s7([PDF Report])
        s8([Multi-Scoreboard Management])
        s9([Admin-Managed Questions and Results])
        s10([Tracking and Attribution Storage])
    end

    subgraph NotSupported["System Should Not Be Responsible For"]
        n1([Learning Journey])
        n2([Modules])
        n3([Lessons])
        n4([Student Progress])
        n5([Certificates])
        n6([Course Access Tier])
        n7([Full Marketing Site Builder])
        n8([Complex Campaign Automation])
        n9([Outbound CRM Sync in MVP])
        n10([Payments and Subscriptions])
    end

    title --> Supported
    title --> NotSupported

    class title title;
    class s1,s2,s3,s4,s5,s6,s7,s8,s9,s10 yes;
    class n1,n2,n3,n4,n5,n6,n7,n8,n9,n10 no;
